# =============================================================================
# jarvis-mk3/.env.example
#
# Copy to `.env` and fill in. The real `.env` is git-ignored and never
# committed. Every variable the system reads is documented here - this
# file IS the config reference.
#
# All variables are prefixed JARVIS_ (namespacing; enforced in settings.py).
# =============================================================================

# Absolute path where the Core keeps ALL its state: core.db, artifacts/,
# backups/. On the VPS this will be /opt/jarvis/data.
# For local development, any writable folder works, e.g. ./data
JARVIS_DATA_DIR=./data

# Log verbosity: DEBUG | INFO | WARNING | ERROR
JARVIS_LOG_LEVEL=INFO

# The owner's IANA timezone. Storage is always UTC; this is used for
# anything owner-facing - schedules, "nightly" jobs, displayed times.
JARVIS_OWNER_TIMEZONE=Asia/Kolkata

# -- LLM provider (phase 1) ---------------------------------------------------

# Anthropic API key. Without it the Core still BOOTS AND RUNS - only model
# calls fail, with a clear error. Get one at console.anthropic.com.
JARVIS_ANTHROPIC_API_KEY=

# Tier -> model mapping. Code only ever asks for a tier; these lines decide
# what a tier means. Swap models here, restart, done - no code changes.
#   reasoner - the orchestrator and subagents (smart, more expensive)
#   utility  - summaries, extraction, chores (fast, cheap)
JARVIS_MODEL_REASONER=claude-sonnet-4-6
JARVIS_MODEL_UTILITY=claude-haiku-4-5