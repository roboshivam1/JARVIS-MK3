# =============================================================================
# jarvis-mk3/.env.example
#
# Copy to `.env` and fill in. The real `.env` is git-ignored and never
# committed. Every variable the system reads is documented here - this
# file IS the config reference.
#
# All variables are prefixed JARVIS_ (namespacing; enforced in settings.py).
# =============================================================================

# Absolute path where the Core keeps ALL its state: core.db, artifacts/,
# backups/. On the VPS this will be /opt/jarvis/data.
# For local development, any writable folder works, e.g. ./data
JARVIS_DATA_DIR=./data

# Log verbosity: DEBUG | INFO | WARNING | ERROR
JARVIS_LOG_LEVEL=INFO

# The owner's IANA timezone. Storage is always UTC; this is used for
# anything owner-facing - schedules, "nightly" jobs, displayed times.
JARVIS_OWNER_TIMEZONE=Asia/Kolkata

# -- LLM provider -------------------------------------------------------------

# Anthropic API key. Without it the Core still BOOTS AND RUNS - only model
# calls fail, with a clear error. Get one at console.anthropic.com.
JARVIS_ANTHROPIC_API_KEY=

# Tier -> model mapping. Code only ever asks for a tier; these lines decide
# what a tier means. Swap models here, restart, done - no code changes.
JARVIS_MODEL_REASONER=claude-sonnet-4-6
JARVIS_MODEL_UTILITY=claude-haiku-4-5

# -- Embeddings (semantic memory) ---------------------------------------------

# Which provider computes embeddings: ollama | voyage | none
#   ollama - a local model on this machine. No key, no bill, no rate
#            limits. Requires `ollama serve` running and the model pulled.
#   voyage - hosted (dash.voyageai.com). Needs a card on file for usable
#            rate limits. The right choice for a small VPS with no local
#            model.
#   none   - memory runs keyword-only; paraphrased questions will miss.
JARVIS_EMBEDDER_PROVIDER=ollama

# The embedding model, interpreted by whichever provider is selected.
#   ollama: nomic-embed-text  (pull it with: ollama pull nomic-embed-text)
#   voyage: voyage-3.5-lite
# Vectors from different models are NOT comparable, so facts record which
# model embedded them and stale ones are re-embedded automatically.
JARVIS_MODEL_EMBEDDER=nomic-embed-text

# Where the local Ollama server listens.
JARVIS_OLLAMA_BASE_URL=http://localhost:11434

# When nightly memory maintenance runs (cron, in your timezone).
# Changing this later does NOT move an existing schedule - the seeded row
# is left alone once created, so edit the schedules table if you want to
# move it after the fact.
JARVIS_SLEEP_CYCLE_CRON=30 3 * * *

# Only needed when the provider is voyage.
JARVIS_VOYAGE_API_KEY=

# -- Gateway (the Core's HTTP door) -------------------------------------------

# Where the gateway listens. 127.0.0.1 for local development; on the VPS
# this stays loopback too if you front it with a reverse proxy, or becomes
# 0.0.0.0 behind a firewall/tailscale. Never expose it bare to the world.
JARVIS_GATEWAY_HOST=127.0.0.1
JARVIS_GATEWAY_PORT=8321

# The shared secret every gateway request must present as
# "Authorization: Bearer <token>". Generate a strong one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = gateway refuses ALL authed routes (safe default, not open).
JARVIS_GATEWAY_TOKEN=

# -- Telegram (phase 1 client) ------------------------------------------------

# Bot token from @BotFather. Empty = the Telegram bridge simply does not
# start; the rest of the Core runs normally.
JARVIS_TELEGRAM_BOT_TOKEN=

# YOUR numeric Telegram user id (ask @userinfobot). Every message from any
# other id is ignored and logged. 0 = unset; bridge will refuse to start
# with a token but no owner id - an open bot is worse than no bot.
JARVIS_TELEGRAM_OWNER_ID=0